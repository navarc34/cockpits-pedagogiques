{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/pilotage.schema.json",
  "title": "Contrat des objectifs et actions de trajectoire",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "meta",
    "fr"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "libelle",
        "dateReference",
        "validation"
      ],
      "properties": {
        "libelle": {
          "type": "string",
          "minLength": 1
        },
        "dateReference": {
          "$ref": "#/$defs/date"
        },
        "validation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fr": {
      "$ref": "#/$defs/course"
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "reference",
        "statut"
      ],
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "statut": {
          "enum": [
            "à confirmer",
            "validée"
          ]
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "date",
        "type",
        "reference"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "type": {
          "enum": [
            "seance",
            "jalon",
            "document"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "objectif": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "libelle",
        "cible",
        "unite",
        "echeance",
        "source",
        "methode",
        "realisation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "libelle": {
          "type": "string",
          "minLength": 1
        },
        "cible": {
          "type": "integer",
          "minimum": 1
        },
        "unite": {
          "type": "string",
          "minLength": 1
        },
        "echeance": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "methode": {
          "type": "string",
          "minLength": 1
        },
        "realisation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "confirmees",
            "candidates",
            "exclues"
          ],
          "properties": {
            "confirmees": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/proof"
              }
            },
            "candidates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/proof"
              }
            },
            "exclues": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/proof"
              }
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "titre",
        "echeance",
        "importance",
        "etat",
        "certitude",
        "justification",
        "jalonId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "titre": {
          "type": "string",
          "minLength": 1
        },
        "echeance": {
          "$ref": "#/$defs/date"
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "etat": {
          "enum": [
            "à instruire",
            "validée",
            "en cours",
            "réalisée",
            "abandonnée"
          ]
        },
        "certitude": {
          "enum": [
            "confirmée",
            "proposée"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "jalonId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectifs",
        "actions"
      ],
      "properties": {
        "objectifs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/objectif"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    }
  }
}
